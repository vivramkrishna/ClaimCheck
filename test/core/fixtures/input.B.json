  "pr": {
    "number": 3,
    "title": "Fix login timeout on slow networks",
    "body": "Fixes #1. Root cause: the 5 s request timeout aborts the session handshake on slow networks, so users get logged out. Raised the timeout to 30 s and added retry-safe dispatch. All tests pass.",
    "state": "open",
    "html_url": "https://github.com/demo-owner/pr-reality-check-demo/pull/3",
    "issue_url": "https://api.github.com/repos/demo-owner/pr-reality-check-demo/issues/3",
    "user": {
      "login": "bob-dev"
    },
    "head": {
      "sha": "b0b0000000000000000000000000000000000003",
      "ref": "fix/login-timeout"
    },
    "base": {
