  "files": [
    {
      "filename": "src/config.js",
      "status": "modified",
      "additions": 1,
      "deletions": 1,
      "changes": 2,
      "patch": "@@ -1,2 +1,2 @@\n export const SESSION_TTL_SECONDS = 3600;\n-export const REQUEST_TIMEOUT_MS = 5000;\n+export const REQUEST_TIMEOUT_MS = 30000;"
    },
    {
      "filename": "src/http/middleware.js",
      "status": "modified",
      "additions": 5,
      "deletions": 3,
      "changes": 8,
      "patch": "@@ -9,7 +9,9 @@ export function requireAuth(req) {\n export function withTimeout(handler) {\n   return async (req) => {\n-    const timer = new Promise((_, reject) =>\n-      setTimeout(() => reject(new Error('504 Timeout')), REQUEST_TIMEOUT_MS));\n-    return Promise.race([handler(req), timer]);\n+    let timeoutId;\n+    const timer = new Promise((_, reject) => {\n+      timeoutId = setTimeout(() => reject(new Error('504 Timeout')), REQUEST_TIMEOUT_MS);\n+    });\n+    return Promise.race([handler(req), timer]).finally(() => clearTimeout(timeoutId));\n   };\n }"
    },
    {
      "filename": "src/http/router.js",
      "status": "modified",
      "additions": 13,
      "deletions": 1,
      "changes": 14,
      "patch": "@@ -16,12 +16,24 @@ export function handleProfile(req) {\n   return { status: 200, body: { ok: true } };\n }\n\n+async function retryDispatch(handler, req, attempts = 2) {\n+  let lastErr;\n+  for (let i = 0; i < attempts; i++) {\n+    try {\n+      return await withTimeout(handler)(req);\n+    } catch (err) {\n+      lastErr = err;\n+    }\n+  }\n+  throw lastErr;\n+}\n+\n export async function dispatch(req) {\n   const routes = { 'POST /login': handleLogin, 'GET /profile': handleProfile, 'GET /health': health };\n   const handler = routes[`${req.method} ${req.path}`];\n   if (!handler) return { status: 404, body: { error: 'Not found' } };\n   try {\n-    return await withTimeout(handler)(req);\n+    return await retryDispatch(handler, req);\n   } catch (err) {\n     return { status: Number.parseInt(err.message, 10) || 500, body: { error: err.message } };\n   }"
    }
  ],
  "issue": {
    "number": 1,
    "title": "Users are logged out a few seconds after logging in",
    "body": "Steps: POST /login (demo creds) → GET /profile after ~5 s. Expected 200, got:\n\n```\nError: 401 Session expired\n    at validate (src/auth/authService.js:13)\n```\n\nLooks like `isExpired` returns true right after `createSession`.",
    "html_url": "https://github.com/demo-owner/pr-reality-check-demo/issues/1",
    "updated_at": "2026-10-31T05:20:00Z",
    "state": "open"
  },
  "linkedIssueSource": "body_regex",
  "openPRs": [
    {
      "number": 2,
      "title": "Fix session TTL units",
      "author": "alice-dev",
      "headSha": "a0a0000000000000000000000000000000000002",
      "linkedIssue": 1,
      "files": [
        {
          "filename": "src/session/sessionStore.js",
          "status": "modified",
          "additions": 1,
          "deletions": 1,
          "changes": 2,
          "patch": "@@ -4,7 +4,7 @@ import { now } from '../utils/time.js';\n const sessions = new Map();\n\n export function createSession(userId, ttlSeconds) {\n-  const session = { id: crypto.randomUUID(), userId, expiresAt: now() + ttlSeconds };\n+  const session = { id: crypto.randomUUID(), userId, expiresAt: now() + ttlSeconds * 1000 };\n   sessions.set(session.id, session);\n   return session;\n }"
        },
        {
          "filename": "tests/session.test.js",
          "status": "modified",
          "additions": 5,
          "deletions": 0,
          "changes": 5,
          "patch": "@@ -11,3 +11,8 @@ test('isExpired is false for a fresh session', () => {\n   const s = createSession('demo', 3600);\n   assert.equal(isExpired(s), false);\n });\n+\n+test('session TTL is in seconds (regression for #1)', () => {\n+  const s = createSession('demo', 60);\n+  assert.ok(s.expiresAt - Date.now() > 59_000);\n+});"
        }
      ]
    },
    {
      "number": 4,
      "title": "Convert session expiry to milliseconds",
      "author": "carol-dev",
      "headSha": "c0c0000000000000000000000000000000000004",
      "linkedIssue": 1,
      "files": [
        {
          "filename": "src/utils/time.js",
          "status": "modified",
          "additions": 4,
          "deletions": 0,
          "changes": 4,
          "patch": "@@ -1,3 +1,7 @@\n export function now() {\n   return Date.now();\n }\n+\n+export function toMs(seconds) {\n+  return seconds * 1000;\n+}"
        },
        {
          "filename": "src/session/sessionStore.js",
          "status": "modified",
          "additions": 2,
          "deletions": 2,
          "changes": 4,
          "patch": "@@ -1,10 +1,10 @@\n import crypto from 'node:crypto';\n-import { now } from '../utils/time.js';\n+import { now, toMs } from '../utils/time.js';\n\n const sessions = new Map();\n\n export function createSession(userId, ttlSeconds) {\n-  const session = { id: crypto.randomUUID(), userId, expiresAt: now() + ttlSeconds };\n+  const session = { id: crypto.randomUUID(), userId, expiresAt: now() + toMs(ttlSeconds) };\n   sessions.set(session.id, session);\n   return session;\n }"
        }
      ]
    }
