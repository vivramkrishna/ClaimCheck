PORT=3000
# Fine-grained PAT: only the demo repo, permissions Pull requests: Read, Issues: Read, Contents: Read, Metadata: Read
GITHUB_TOKEN=
# Google AI Studio key (https://aistudio.google.com/apikey); Gemma 4 runs through the Gemini API
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# Your GitHub username that owns the demo repo
DEMO_REPO_OWNER=
DEMO_REPO_NAME=pr-reality-check-demo

# Optional tuning (core engine)
# Set to false only if `node scripts/check.js --inspect data/graph.json` says source = CALLEE
EDGE_SOURCE_IS_CALLER=true
# Set to minimal if live Gemma calls take more than ~15 s
GEMMA_THINKING_LEVEL=
GEMMA_TIMEOUT_MS=45000
